<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.w3id.org/efro/efro#"
     xml:base="http://www.w3id.org/efro/efro"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    <owl:Ontology rdf:about="https://www.w3id.org/cco/cco-education/imports/efro_module"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3id.org/efro/efro#ApprenticeshipFunding -->

    <owl:Class rdf:about="http://www.w3id.org/efro/efro#ApprenticeshipFunding">
        <rdfs:comment>A funding resource allocated to support apprenticeship programmes.</rdfs:comment>
        <rdfs:label>Apprenticeship Funding</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3id.org/efro/efro#ComplianceObligation -->

    <owl:Class rdf:about="http://www.w3id.org/efro/efro#ComplianceObligation">
        <rdfs:comment>An obligation that an education provider or participant must fulfil to remain compliant with funding regulations.</rdfs:comment>
        <rdfs:label>Compliance Obligation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3id.org/efro/efro#FundingCondition -->

    <owl:Class rdf:about="http://www.w3id.org/efro/efro#FundingCondition">
        <rdfs:comment>A condition that determines whether a student or provider is eligible to receive education funding.</rdfs:comment>
        <rdfs:label>Funding Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3id.org/efro/efro#FundingObligation -->

    <owl:Class rdf:about="http://www.w3id.org/efro/efro#FundingObligation">
        <rdfs:comment>An obligation related to the conditions that must be met to receive or retain education funding.</rdfs:comment>
        <rdfs:label>Funding Obligation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3id.org/efro/efro#FundingRegulations -->

    <owl:Class rdf:about="http://www.w3id.org/efro/efro#FundingRegulations">
        <rdfs:comment>A regulation that specifies the conditions under which education funding is allocated, maintained, or withdrawn.</rdfs:comment>
        <rdfs:label>Funding Regulations</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3id.org/efro/efro#FundingStartCriteria -->

    <owl:Class rdf:about="http://www.w3id.org/efro/efro#FundingStartCriteria">
        <rdfs:comment>A condition that must be satisfied before funding for a student or programme can commence.</rdfs:comment>
        <rdfs:label>Funding Start Criteria</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3id.org/efro/efro#RegulatoryBody -->

    <owl:Class rdf:about="http://www.w3id.org/efro/efro#RegulatoryBody">
        <rdfs:comment>An agent that holds regulatory authority and issues or oversees education funding regulations.</rdfs:comment>
        <rdfs:label>Regulatory Body</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3id.org/efro/efro#ReportingObligation -->

    <owl:Class rdf:about="http://www.w3id.org/efro/efro#ReportingObligation">
        <rdfs:comment>An obligation to submit records or compliance evidence to a regulatory authority.</rdfs:comment>
        <rdfs:label>Reporting Obligation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3id.org/efro/efro#TimeCondition -->

    <owl:Class rdf:about="http://www.w3id.org/efro/efro#TimeCondition">
        <rdfs:comment>A condition based on a temporal criterion such as a qualifying attendance period.</rdfs:comment>
        <rdfs:label>Time Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3id.org/efro/efro#TraineeshipFunding -->

    <owl:Class rdf:about="http://www.w3id.org/efro/efro#TraineeshipFunding">
        <rdfs:comment>A funding resource allocated to support traineeship programmes.</rdfs:comment>
        <rdfs:label>Traineeship Funding</rdfs:label>
    </owl:Class>
</rdf:RDF>



