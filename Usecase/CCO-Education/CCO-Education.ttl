@prefix : <http://www.example.org/cco-education#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix cco: <http://www.example.org/cco#> .
@prefix edu: <http://www.example.org/cco-education#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix efro: <http://www.w3id.org/efro/efro#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://www.example.org/cco-education#> .

<http://www.example.org/cco-education> rdf:type owl:Ontology ;
                                        owl:imports <http://www.example.org/cco> ,
                                                    <http://www.example.org/cco-education/imports/efro_module> ;
                                        dc:creator "Umair Arshad" ;
                                        dc:date "2026" ;
                                        dc:description "A domain-independent core ontology for modelling the regulatory structure of regulations across diverse compliance domains. It captures regulations, norms including obligations, permissions, and prohibitions, conditions, exceptions, actions, roles, agents, resources, and regulatory authority agents and roles. The ontology supports temporal modelling of norm applicability and role holding, while enabling domain-specific extensions for specialised compliance contexts."@en ;
                                        <http://purl.org/dc/terms/contributor> "David Corsar" ,
                                                                               "Ikechukwu Nkisi-Orji" ;
                                        <http://purl.org/dc/terms/rights> "This ontology is licensed under the Creative Commons Attribution 4.0 International License (CC-BY 4.0)." ;
                                        rdfs:label "CCO Education Extension"@en ;
                                        owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  http://www.example.org/cco-education#AdministrativeStaffRole
edu:AdministrativeStaffRole rdf:type owl:Class ;
                            rdfs:subClassOf edu:StaffRole ;
                            rdfs:label "Administrative Staff Role"@en ;
                            skos:closeMatch efro:AdministrativeStaff .


###  http://www.example.org/cco-education#ApprenticeRole
edu:ApprenticeRole rdf:type owl:Class ;
                   rdfs:subClassOf edu:ParticipantRole ;
                   rdfs:label "Apprentice Role"@en ;
                   skos:closeMatch efro:Apprentice .


###  http://www.example.org/cco-education#ApprenticeshipProviderRole
edu:ApprenticeshipProviderRole rdf:type owl:Class ;
                               rdfs:subClassOf edu:EducationalProviderRole ;
                               rdfs:label "Apprenticeship Provider Role"@en ;
                               skos:closeMatch efro:ApprenticeshipProvider .


###  http://www.example.org/cco-education#EducationalInstitutionRole
edu:EducationalInstitutionRole rdf:type owl:Class ;
                               rdfs:subClassOf cco:Role ;
                               rdfs:label "Educational Institution Role"@en ;
                               skos:closeMatch efro:EducationalInstitution ;
                               skos:definition "A role held by an organisation that provides education and is subject to funding regulations."@en .


###  http://www.example.org/cco-education#EducationalProviderRole
edu:EducationalProviderRole rdf:type owl:Class ;
                            rdfs:subClassOf cco:Role ;
                            rdfs:label "Educational Provider Role"@en ;
                            skos:closeMatch efro:EducationalProvider ;
                            skos:definition "A role held by an organisation that delivers education programmes and is subject to ESFA funding compliance obligations."@en .


###  http://www.example.org/cco-education#FullTimeStudentRole
edu:FullTimeStudentRole rdf:type owl:Class ;
                        rdfs:subClassOf edu:StudentRole ;
                        rdfs:label "Full Time Student Role"@en ;
                        skos:closeMatch efro:FullTimeStudent .


###  http://www.example.org/cco-education#PartTimeStudentRole
edu:PartTimeStudentRole rdf:type owl:Class ;
                        rdfs:subClassOf edu:StudentRole ;
                        rdfs:label "Part Time Student Role"@en ;
                        skos:closeMatch efro:PartTimeStudent .


###  http://www.example.org/cco-education#ParticipantRole
edu:ParticipantRole rdf:type owl:Class ;
                    rdfs:subClassOf cco:Role ;
                    rdfs:label "Participant Role"@en ;
                    skos:closeMatch efro:Participant ;
                    skos:definition "A role held by a person participating in an education or training programme."@en .


###  http://www.example.org/cco-education#StaffRole
edu:StaffRole rdf:type owl:Class ;
              rdfs:subClassOf cco:Role ;
              rdfs:label "Staff Role"@en ;
              skos:closeMatch efro:Staff ;
              skos:definition "A role held by a person employed by an educational institution."@en .


###  http://www.example.org/cco-education#StudentRole
edu:StudentRole rdf:type owl:Class ;
                rdfs:subClassOf cco:Role ;
                rdfs:label "Student Role"@en ;
                skos:closeMatch efro:Student ;
                skos:definition "A role held by a person who is enrolled in an education programme and subject to attendance and funding compliance requirements."@en .


###  http://www.example.org/cco-education#TeachingStaffRole
edu:TeachingStaffRole rdf:type owl:Class ;
                      rdfs:subClassOf edu:StaffRole ;
                      rdfs:label "Teaching Staff Role"@en ;
                      skos:closeMatch efro:TeachingStaff .


###  http://www.example.org/cco-education#TraineeRole
edu:TraineeRole rdf:type owl:Class ;
                rdfs:subClassOf edu:ParticipantRole ;
                rdfs:label "Trainee Role"@en ;
                skos:closeMatch efro:Trainee .


###  http://www.example.org/cco-education#TrainingProviderRole
edu:TrainingProviderRole rdf:type owl:Class ;
                         rdfs:subClassOf edu:EducationalProviderRole ;
                         rdfs:label "Training Provider Role"@en ;
                         skos:closeMatch efro:TrainingProvider .


###  http://www.w3id.org/efro/efro#ApprenticeshipFunding
efro:ApprenticeshipFunding rdfs:subClassOf cco:Resource .


###  http://www.w3id.org/efro/efro#ComplianceObligation
efro:ComplianceObligation rdfs:subClassOf cco:Obligation .


###  http://www.w3id.org/efro/efro#FundingCondition
efro:FundingCondition rdfs:subClassOf cco:Condition .


###  http://www.w3id.org/efro/efro#FundingObligation
efro:FundingObligation rdfs:subClassOf cco:Obligation .


###  http://www.w3id.org/efro/efro#FundingRegulations
efro:FundingRegulations rdfs:subClassOf cco:Regulation .


###  http://www.w3id.org/efro/efro#FundingStartCriteria
efro:FundingStartCriteria rdfs:subClassOf cco:Condition .


###  http://www.w3id.org/efro/efro#RegulatoryBody
efro:RegulatoryBody rdfs:subClassOf cco:RegulatoryAuthorityAgent .


###  http://www.w3id.org/efro/efro#ReportingObligation
efro:ReportingObligation rdfs:subClassOf cco:Obligation .


###  http://www.w3id.org/efro/efro#TimeCondition
efro:TimeCondition rdfs:subClassOf cco:Condition .


###  http://www.w3id.org/efro/efro#TraineeshipFunding
efro:TraineeshipFunding rdfs:subClassOf cco:Resource .


