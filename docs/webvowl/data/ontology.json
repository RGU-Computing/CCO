    "baseIris" : [ "http://www.w3.org/1999/02/22-rdf-syntax-ns", "http://www.w3.org/2000/01/rdf-schema", "http://www.w3.org/2001/XMLSchema", "https://www.w3id.org/cco/cco" ],
    "title" : {
      "en" : "CCO: A Core Compliance Ontology for Modelling the Normative Structure of Regulations"
    },
    "iri" : "https://www.w3id.org/cco/cco",
    "version" : "1.0",
    "author" : [ "Umair Arshad" ],
    "description" : {
      "en" : "A domain-independent core ontology for modelling the regulatory structure of regulations across diverse compliance domains. It captures regulations, norms including obligations, permissions, and prohibitions, conditions, exceptions, actions, roles, agents, resources, and regulatory authority agents and roles. The ontology supports temporal modelling of norm applicability and role holding, while enabling domain-specific extensions for specialised compliance contexts."
    },
    "other" : {
      "license" : [ {
        "identifier" : "license",
        "language" : "undefined",
        "value" : "https://creativecommons.org/licenses/by/4.0/",
        "type" : "iri"
      } ],
      "creator" : [ {
        "identifier" : "creator",
        "language" : "undefined",
        "value" : "Umair Arshad",
        "type" : "label"
      } ],
      "contributor" : [ {
        "identifier" : "contributor",
        "language" : "undefined",
        "value" : "David Corsar",
        "type" : "label"
      }, {
        "identifier" : "contributor",
        "language" : "undefined",
        "value" : "Ikechukwu Nkisi-Orji",
        "type" : "label"
      } ],
      "rights" : [ {
        "identifier" : "rights",
        "language" : "en",
        "value" : "CC-BY 4.0",
        "type" : "label"
      } ],
      "abstract" : [ {
        "identifier" : "abstract",
        "language" : "undefined",
        "value" : "Regulatory compliance applications increasingly combine Semantic Web representations with large language model (LLM); however, transforming regulatory text into structured models that support reliable querying and reasoning remains challenging. Formal ontologies and policy languages for modelling regulations often require domain-specific vocabularies and formal encodings of conditions and actions, which can make reuse across compliance domains challenging. This paper presents the Core Compliance Ontology (CCO), a domain-independent OWL ontology that provides a lightweight vocabulary for representing the obligations, permissions, and prohibitions defined in regulations, together with their applicability conditions, exceptions, role-based scope, and temporal validity. CCO models regulatory instruments and the agents and roles involved in issuing and complying with regulations, recording condition and action descriptions as plain text strings to support structured querying and retrieval-augmented generation workflows. The ontology is evaluated in two stages: first, through competency question-based SPARQL ASK verification over the CCO schema; second, through an LLM-assisted cross-domain evaluation examining CCO's applicability across education funding, finance, healthcare, and data protection regulations.",
        "type" : "label"
      } ],
