@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cco:  <http://www.example.org/cco#> .

#################################################################
# CCO sanity SHACL shapes (domain-independent)
# - Violations reflect strict OWL restrictions in the CCO schema.
# - Warnings reflect recommended completeness checks.
#################################################################

#################################################################
# Regulation sanity checks
#################################################################

cco:RegulationShape
  a sh:NodeShape ;
  sh:targetClass cco:Regulation ;

  sh:property [
    sh:path cco:specifiesNorm ;
    sh:minCount 1 ;
    sh:or (
      [ sh:class cco:Norm ]
      [ sh:class cco:Obligation ]
      [ sh:class cco:Permission ]
      [ sh:class cco:Prohibition ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A Regulation must specify at least one Norm (cco:specifiesNorm min 1)." ;
  ] ;

  sh:property [
    sh:path cco:hasValidityStart ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
    sh:severity sh:Violation ;
    sh:message "A Regulation must have exactly one hasValidityStart (xsd:date)." ;
  ] ;

  sh:property [
    sh:path cco:hasValidityEnd ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
    sh:severity sh:Violation ;
    sh:message "A Regulation may have at most one hasValidityEnd (xsd:date)." ;
  ] ;

  sh:property [
    sh:path cco:supersedes ;
    sh:class cco:Regulation ;
    sh:severity sh:Violation ;
    sh:message "If present, supersedes must point to a Regulation." ;
  ] ;

  sh:property [
    sh:path cco:regulates ;
    sh:class cco:Resource ;
    sh:severity sh:Violation ;
    sh:message "If present, regulates must point to a Resource." ;
  ] .

#################################################################
# Norm sanity checks
#################################################################

cco:NormShape
  a sh:NodeShape ;
  sh:targetClass cco:Norm ;

  sh:property [
    sh:path cco:hasApplicabilityStart ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
    sh:severity sh:Violation ;
    sh:message "A Norm may have at most one hasApplicabilityStart (xsd:date)." ;
  ] ;

  sh:property [
    sh:path cco:hasApplicabilityEnd ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
    sh:severity sh:Violation ;
    sh:message "A Norm may have at most one hasApplicabilityEnd (xsd:date)." ;
  ] ;

  sh:property [
    sh:path cco:appliesToRole ;
    sh:or (
      [ sh:class cco:Role ]
      [ sh:class cco:RegulatoryAuthorityRole ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "If present, appliesToRole must point to a Role." ;
  ] ;

  sh:property [
    sh:path cco:appliesUnder ;
    sh:class cco:Condition ;
    sh:severity sh:Violation ;
    sh:message "If present, appliesUnder must point to a Condition." ;
  ] ;

  sh:property [
    sh:path cco:hasException ;
    sh:class cco:Exception ;
    sh:severity sh:Violation ;
    sh:message "If present, hasException must point to an Exception." ;
  ] ;

  sh:property [
    sh:path cco:hasAction ;
    sh:minCount 1 ;
    sh:class cco:Action ;
    sh:severity sh:Warning ;
    sh:message "Recommended: a Norm should link to an Action via cco:hasAction." ;
  ] ;

  sh:property [
    sh:path cco:hasObject ;
    sh:minCount 1 ;
    sh:class cco:Resource ;
    sh:severity sh:Warning ;
    sh:message "Recommended: a Norm should link to a Resource via cco:hasObject." ;
  ] .

#################################################################
# Deontic types (recommended role scoping)
#################################################################

cco:ObligationShape
  a sh:NodeShape ;
  sh:targetClass cco:Obligation ;
  sh:property [
    sh:path cco:appliesToRole ;
    sh:minCount 1 ;
    sh:or (
      [ sh:class cco:Role ]
      [ sh:class cco:RegulatoryAuthorityRole ]
    ) ;
    sh:severity sh:Warning ;
    sh:message "Recommended: an Obligation should apply to at least one Role (appliesToRole)." ;
  ] .

cco:PermissionShape
  a sh:NodeShape ;
  sh:targetClass cco:Permission ;
  sh:property [
    sh:path cco:appliesToRole ;
    sh:minCount 1 ;
    sh:or (
      [ sh:class cco:Role ]
      [ sh:class cco:RegulatoryAuthorityRole ]
    ) ;
    sh:severity sh:Warning ;
    sh:message "Recommended: a Permission should apply to at least one Role (appliesToRole)." ;
  ] .

cco:ProhibitionShape
  a sh:NodeShape ;
  sh:targetClass cco:Prohibition ;
  sh:property [
    sh:path cco:appliesToRole ;
    sh:minCount 1 ;
    sh:or (
      [ sh:class cco:Role ]
      [ sh:class cco:RegulatoryAuthorityRole ]
    ) ;
    sh:severity sh:Warning ;
    sh:message "Recommended: a Prohibition should apply to at least one Role (appliesToRole)." ;
  ] .

#################################################################
# Exception sanity checks
#################################################################

cco:ExceptionShape
  a sh:NodeShape ;
  sh:targetClass cco:Exception ;

  sh:property [
    sh:path cco:modifiesNorm ;
    sh:minCount 1 ;
    sh:or (
      [ sh:class cco:Norm ]
      [ sh:class cco:Obligation ]
      [ sh:class cco:Permission ]
      [ sh:class cco:Prohibition ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "An Exception must modify at least one Norm (modifiesNorm min 1)." ;
  ] ;

  sh:property [
    sh:path cco:hasCondition ;
    sh:minCount 1 ;
    sh:class cco:Condition ;
    sh:severity sh:Violation ;
    sh:message "An Exception must have at least one Condition (hasCondition min 1)." ;
  ] .

#################################################################
# RoleHolding sanity checks
#################################################################

cco:RoleHoldingShape
  a sh:NodeShape ;
  sh:targetClass cco:RoleHolding ;

  sh:property [
    sh:path cco:hasRole ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:class cco:Role ]
      [ sh:class cco:RegulatoryAuthorityRole ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A RoleHolding must have exactly one Role (hasRole exactly 1)." ;
  ] ;

  sh:property [
    sh:path cco:hasStartTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
    sh:severity sh:Violation ;
    sh:message "A RoleHolding must have exactly one hasStartTime (xsd:date)." ;
  ] ;

  sh:property [
    sh:path cco:hasEndTime ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
    sh:severity sh:Violation ;
    sh:message "A RoleHolding may have at most one hasEndTime (xsd:date)." ;
  ] .

#################################################################
# Agent sanity checks
#################################################################

cco:AgentShape
  a sh:NodeShape ;
  sh:targetClass cco:Agent ;

  sh:property [
    sh:path cco:holdsRole ;
    sh:class cco:RoleHolding ;
    sh:severity sh:Violation ;
    sh:message "If present, holdsRole must point to a RoleHolding." ;
  ] .

#################################################################
# RegulatoryAuthorityAgent sanity checks
#################################################################

cco:RegulatoryAuthorityAgentShape
  a sh:NodeShape ;
  sh:targetClass cco:RegulatoryAuthorityAgent ;

  sh:property [
    sh:path cco:issues ;
    sh:minCount 1 ;
    sh:class cco:Regulation ;
    sh:severity sh:Warning ;
    sh:message "Recommended: a RegulatoryAuthorityAgent should issue at least one Regulation (issues min 1)." ;
  ] .

#################################################################
# Resource sanity checks
#################################################################

cco:ResourceShape
  a sh:NodeShape ;
  sh:targetClass cco:Resource ;

  sh:property [
    sh:path cco:allocatedTo ;
    sh:class cco:Agent ;
    sh:severity sh:Violation ;
    sh:message "If present, allocatedTo must point to an Agent." ;
  ] .

#################################################################
# Condition sanity checks
#################################################################

cco:ConditionShape
  a sh:NodeShape ;
  sh:targetClass cco:Condition ;

  sh:property [
    sh:path cco:hasConditionExpression ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:severity sh:Warning ;
    sh:message "Recommended: use a single hasConditionExpression (xsd:string) per Condition for traceability." ;
  ] .