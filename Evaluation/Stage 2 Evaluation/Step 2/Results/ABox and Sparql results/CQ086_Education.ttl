@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:EducationRegulation a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:AssessmentObligation ;
    cco:regulates abox:AssessmentResource .

abox:AssessmentObligation a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:appliesToRole abox:ProviderRole ;
    cco:hasAction abox:AssessmentAction ;
    cco:hasObject abox:AssessmentResource .

abox:AssessmentResource a cco:Resource .

abox:AssessmentAction a cco:Action .

abox:ProviderRole a cco:Role .