@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation122 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:ObligationIndependence .

abox:ObligationIndependence a cco:Obligation, cco:Norm ;
    cco:hasAction abox:EnsureIndependenceAction ;
    cco:appliesUnder abox:IndependenceCondition .

abox:EnsureIndependenceAction a cco:Action .
abox:IndependenceCondition a cco:Condition ;
    cco:hasConditionExpression "end-point assessment itself must be independent" .