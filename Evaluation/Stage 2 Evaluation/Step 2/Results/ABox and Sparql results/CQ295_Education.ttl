@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation168 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Prohibition168 .

abox:Prohibition168 a cco:Prohibition, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:Action168 ;
    cco:appliesUnder abox:Condition168 ;
    cco:hasObject abox:Resource168 ;
    cco:appliesToRole abox:EmployerRole .

abox:Action168 a cco:Action .
abox:Condition168 a cco:Condition ;
    cco:hasConditionExpression "Third party authorising payments through apprenticeship service account"^^xsd:string .
abox:Resource168 a cco:Resource .
abox:EmployerRole a cco:Role .