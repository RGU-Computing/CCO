@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation100 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Permission100_2_5 .

abox:Permission100_2_5 a cco:Permission, cco:Norm ;
    cco:appliesUnder abox:Condition100_2_5 .

abox:Condition100_2_5 a cco:Condition ;
    cco:hasConditionExpression "clear overlap between the qualification content and the knowledge, skills and behaviours needed for the apprenticeship" .