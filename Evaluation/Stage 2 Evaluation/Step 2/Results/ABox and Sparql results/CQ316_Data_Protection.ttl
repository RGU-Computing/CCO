@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPRRegulation a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:GDPRProhibition .

abox:GDPRProhibition a cco:Prohibition, cco:Norm ;
    cco:hasException abox:LegalClaimsException .

abox:LegalClaimsException a cco:Exception ;
    cco:modifiesNorm abox:GDPRProhibition ;
    cco:hasCondition abox:LegalClaimsCondition .

abox:LegalClaimsCondition a cco:Condition ;
    cco:hasConditionExpression "for the establishment, exercise or defence of legal claims" .