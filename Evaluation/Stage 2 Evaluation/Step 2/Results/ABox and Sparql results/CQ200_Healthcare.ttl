@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:WHO a cco:RegulatoryAuthorityAgent ;
    cco:holdsRole abox:RoleHolding_DG .

abox:RoleHolding_DG a cco:RoleHolding ;
    cco:hasRole abox:DirectorGeneralRole ;
    cco:hasStartTime "2023-01-01"^^xsd:date .

abox:DirectorGeneralRole a cco:Role .

abox:IHR a cco:Regulation ;
    cco:hasValidityStart "2005-06-23"^^xsd:date ;
    cco:specifiesNorm abox:Obligation_Article48_2 .

abox:Obligation_Article48_2 a cco:Obligation, cco:Norm ;
    cco:appliesToRole abox:DirectorGeneralRole ;
    cco:hasAction abox:SelectMembersAction .

abox:SelectMembersAction a cco:Action .