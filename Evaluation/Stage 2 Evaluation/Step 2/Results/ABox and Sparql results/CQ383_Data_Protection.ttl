@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Article37_7_Obligation .

abox:Article37_7_Obligation a cco:Obligation, cco:Norm ;
    cco:hasAction abox:PublishAndCommunicateAction ;
    cco:hasObject abox:ContactDetailsResource ;
    cco:appliesToRole abox:ControllerOrProcessorRole .

abox:PublishAndCommunicateAction a cco:Action .
abox:ContactDetailsResource a cco:Resource .
abox:ControllerOrProcessorRole a cco:Role .