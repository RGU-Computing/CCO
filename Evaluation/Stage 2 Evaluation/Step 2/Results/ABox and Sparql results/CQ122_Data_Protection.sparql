PREFIX cco: <http://www.example.org/cco#>
PREFIX abox: <http://www.example.org/abox#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?action WHERE {
  abox:BreachNotificationObligation cco:appliesUnder ?condition .
  ?condition cco:hasConditionExpression "notification of a personal data breach cannot be made within 72 hours" .
  abox:BreachNotificationObligation cco:hasAction ?action .
}