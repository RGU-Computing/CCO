PREFIX cco: <http://www.example.org/cco#>
PREFIX abox: <http://www.example.org/abox#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?norm WHERE {
  ?norm a cco:Norm ;
         cco:hasAction abox:ProcessingAction ;
         cco:appliesUnder abox:AnonymousCondition ;
         cco:hasObject abox:AnonymousInformation .
}