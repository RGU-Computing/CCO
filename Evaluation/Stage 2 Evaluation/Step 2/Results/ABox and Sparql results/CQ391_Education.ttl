@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:PreventRegulation a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:PreventObligation .

abox:PreventObligation a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:PreventAction ;
    cco:appliesUnder abox:SubcontractedCondition .

abox:PreventAction a cco:Action .

abox:SubcontractedCondition a cco:Condition ;
    cco:hasConditionExpression "subcontracted provision" .