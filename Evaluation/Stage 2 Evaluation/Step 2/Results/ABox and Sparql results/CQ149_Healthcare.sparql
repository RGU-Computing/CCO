PREFIX cco: <http://www.example.org/cco#>
PREFIX abox: <http://www.example.org/abox#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?conditionExpression
WHERE {
  abox:Permission_Article37_4b cco:appliesUnder ?condition .
  ?condition cco:hasConditionExpression ?conditionExpression .
}