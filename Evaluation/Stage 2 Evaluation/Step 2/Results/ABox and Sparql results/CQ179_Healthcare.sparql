PREFIX cco: <http://www.example.org/cco#>
PREFIX abox: <http://www.example.org/abox#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?permission ?action ?condition
WHERE {
  abox:ConsultationPermission a cco:Permission ;
                             cco:hasAction abox:RequestConsultationAction ;
                             cco:appliesUnder abox:ImpactedCondition .
  abox:ImpactedCondition cco:hasConditionExpression "State Party impacted by a health measure" .
}