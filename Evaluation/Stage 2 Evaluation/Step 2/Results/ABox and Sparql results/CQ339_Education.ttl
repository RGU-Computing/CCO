@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation_238 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation_238 .

abox:Obligation_238 a cco:Obligation, cco:Norm ;
    cco:hasAction abox:Action_MaintainRelationship ;
    cco:appliesToRole abox:ProviderRole .

abox:Action_MaintainRelationship a cco:Action .
abox:ProviderRole a cco:Role .