PREFIX cco: <http://www.example.org/cco#>
PREFIX abox: <http://www.example.org/abox#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?basis
WHERE {
  abox:Regulation1 cco:specifiesNorm abox:Obligation1 .
  abox:Obligation1 cco:appliesUnder abox:Condition1 .
  abox:Condition1 cco:hasConditionExpression ?basis .
}