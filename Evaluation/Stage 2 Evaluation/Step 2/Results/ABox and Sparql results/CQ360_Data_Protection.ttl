@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPRRegulation a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Article29Prohibition .

abox:Article29Prohibition a cco:Prohibition, cco:Norm ;
    cco:hasAction abox:ProcessDataAction ;
    cco:appliesToRole abox:ProcessorRole ;
    cco:appliesUnder abox:AccessCondition ;
    cco:hasObject abox:PersonalDataResource .

abox:ProcessDataAction a cco:Action .
abox:ProcessorRole a cco:Role .
abox:AccessCondition a cco:Condition ;
    cco:hasConditionExpression "has access to personal data" .
abox:PersonalDataResource a cco:Resource .