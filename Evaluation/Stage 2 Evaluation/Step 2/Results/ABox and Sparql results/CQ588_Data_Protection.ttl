@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPRRegulation a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:CompensationPermission .

abox:CompensationPermission a cco:Permission, cco:Norm ;
    cco:hasAction abox:ReceiveCompensationAction ;
    cco:hasObject abox:CompensationResource ;
    cco:appliesToRole abox:PersonRole ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date .

abox:ReceiveCompensationAction a cco:Action .
abox:CompensationResource a cco:Resource .
abox:PersonRole a cco:Role .