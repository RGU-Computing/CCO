@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:ApprenticeshipRegulation a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:MinimumDurationObligation .

abox:MinimumDurationObligation a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:MeetMinimumDurationAction ;
    cco:appliesUnder abox:PriorLearningCondition ;
    cco:hasException abox:ReductionException .

abox:MeetMinimumDurationAction a cco:Action .

abox:PriorLearningCondition a cco:Condition ;
    cco:hasConditionExpression "if reduced due to prior learning"^^xsd:string .

abox:ReductionException a cco:Exception ;
    cco:modifiesNorm abox:MinimumDurationObligation ;
    cco:hasCondition abox:MinimumHoursCondition .

abox:MinimumHoursCondition a cco:Condition ;
    cco:hasConditionExpression "no programme must fall below 187 hours of evidenced delivery or 8 months in actual duration"^^xsd:string .