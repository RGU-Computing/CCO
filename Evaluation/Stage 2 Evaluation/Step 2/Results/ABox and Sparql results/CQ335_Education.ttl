@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation213 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation213_2 .

abox:Obligation213_2 a cco:Obligation, cco:Norm ;
    cco:hasAction abox:AgreeAction ;
    cco:appliesToRole abox:ReceivingEmployerRole ;
    cco:hasObject abox:ApprenticeshipStandardResource .

abox:AgreeAction a cco:Action .
abox:ReceivingEmployerRole a cco:Role .
abox:ApprenticeshipStandardResource a cco:Resource .