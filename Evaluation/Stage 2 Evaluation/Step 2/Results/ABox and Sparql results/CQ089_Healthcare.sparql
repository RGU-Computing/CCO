PREFIX cco: <http://www.example.org/cco#>
PREFIX abox: <http://www.example.org/abox#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?arrangement
WHERE {
  abox:Obligation_ContingencyArrangements cco:hasAction ?arrangement ;
                                          cco:appliesToRole abox:Role_CompetentAuthority .
}