SELECT ?regulation WHERE {
  ?regulation a cco:Regulation .
  ?regulation cco:specifiesNorm ?norm .
  ?norm a cco:Obligation .
  ?norm cco:hasAction abox:CommunicateBreach .
  ?norm cco:appliesToRole abox:ControllerRole .
  ?norm cco:hasObject abox:PersonalDataBreach .
  ?norm cco:appliesUnder ?condition .
  ?condition a cco:Condition .
}