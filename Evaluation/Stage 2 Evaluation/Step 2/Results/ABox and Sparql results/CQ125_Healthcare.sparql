PREFIX cco: <http://www.example.org/cco#>
PREFIX abox: <http://www.example.org/abox#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?action WHERE {
  abox:Permission_DenyEntry cco:hasAction ?action .
  abox:Permission_DenyEntry cco:appliesUnder abox:Condition_RefusalConsent .
  abox:Condition_RefusalConsent cco:hasConditionExpression "traveller refuses to consent to a required medical examination" .
}