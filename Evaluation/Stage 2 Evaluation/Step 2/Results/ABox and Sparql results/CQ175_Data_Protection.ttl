@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Obligation_Article61_1 .

abox:Obligation_Article61_1 a cco:Obligation, cco:Norm ;
    cco:hasAction abox:AssistMutuallyAction ;
    cco:appliesToRole abox:SupervisoryAuthorityRole .

abox:SupervisoryAuthorityRole a cco:RegulatoryAuthorityRole .

abox:AssistMutuallyAction a cco:Action .