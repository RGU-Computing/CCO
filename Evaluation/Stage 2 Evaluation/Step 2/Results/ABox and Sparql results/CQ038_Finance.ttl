@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation33 a cco:Regulation ;
    cco:hasValidityStart "2024-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation33 .

abox:Obligation33 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2024-01-01"^^xsd:date ;
    cco:appliesToRole abox:SupervisoryRole ;
    cco:hasAction abox:IncludeIndependentMembersAction .

abox:SupervisoryRole a cco:Role .

abox:IncludeIndependentMembersAction a cco:Action .