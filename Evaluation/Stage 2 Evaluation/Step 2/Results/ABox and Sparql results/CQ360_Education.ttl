@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation1 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation1 .

abox:Obligation1 a cco:Obligation, cco:Norm ;
    cco:appliesToRole abox:ProviderRole ;
    cco:hasAction abox:EnsureAction ;
    cco:hasObject abox:ApprenticeshipStandards ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date .

abox:ProviderRole a cco:Role .

abox:EnsureAction a cco:Action .

abox:ApprenticeshipStandards a cco:Resource .