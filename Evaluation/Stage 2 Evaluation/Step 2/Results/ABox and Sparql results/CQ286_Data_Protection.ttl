@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Article12_6_Permission .

abox:Article12_6_Permission a cco:Permission, cco:Norm ;
    cco:appliesUnder abox:IdentityDoubtCondition ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date .

abox:IdentityDoubtCondition a cco:Condition ;
    cco:hasConditionExpression "the controller has reasonable doubts concerning the identity of the natural person making the request" .