@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation262 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation262 .

abox:Obligation262 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:ActionBreakLearning ;
    cco:appliesUnder abox:ConditionNotPossible .

abox:ConditionNotPossible a cco:Condition ;
    cco:hasConditionExpression "active learning is not possible during a FJAA placement gap" .

abox:ActionBreakLearning a cco:Action .