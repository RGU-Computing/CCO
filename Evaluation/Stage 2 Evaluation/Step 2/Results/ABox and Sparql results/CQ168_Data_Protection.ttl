@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:LimitationObligation .

abox:LimitationObligation a cco:Obligation, cco:Norm ;
    cco:appliesUnder abox:NecessaryCondition ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date .

abox:NecessaryCondition a cco:Condition ;
    cco:hasConditionExpression "appropriate, necessary and proportionate in view of ensuring compliance with this Regulation" .