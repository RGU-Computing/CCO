@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation_Article85 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Prohibition_Article85_2 .

abox:Prohibition_Article85_2 a cco:Prohibition, cco:Norm ;
    cco:appliesUnder abox:Condition_Article85_2 .

abox:Condition_Article85_2 a cco:Condition ;
    cco:hasConditionExpression "a natural or legal person which had the opportunity to bring an action... but had not done so" .