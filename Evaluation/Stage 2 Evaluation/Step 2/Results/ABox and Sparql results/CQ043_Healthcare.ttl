@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:WHO a cco:Organisation, cco:RegulatoryAuthorityAgent .
abox:WHO_ConsultationObligation a cco:Obligation, cco:Norm .
abox:WHO_Regulation a cco:Regulation .
abox:ConsultationAction a cco:Action .
abox:WHO_Regulation cco:hasValidityStart "2023-01-01"^^xsd:date .
abox:WHO_Regulation cco:specifiesNorm abox:WHO_ConsultationObligation .
abox:WHO_ConsultationObligation cco:hasApplicabilityStart "2023-01-01"^^xsd:date .
abox:WHO_ConsultationObligation cco:hasAction abox:ConsultationAction .