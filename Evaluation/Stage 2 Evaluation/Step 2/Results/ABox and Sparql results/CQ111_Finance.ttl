@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation87 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation87 .

abox:Obligation87 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:EnsureComplianceAction ;
    cco:appliesToRole abox:ParentUndertakingRole, abox:SubsidiaryRole .

abox:EnsureComplianceAction a cco:Action .
abox:ParentUndertakingRole a cco:Role .
abox:SubsidiaryRole a cco:Role .