@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Obligation_38_3 .

abox:Obligation_38_3 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date ;
    cco:hasAction abox:DismissOrPenalizeAction ;
    cco:hasException abox:Exception_38_3 .

abox:Exception_38_3 a cco:Exception ;
    cco:modifiesNorm abox:Obligation_38_3 ;
    cco:hasCondition abox:Condition_38_3 .

abox:Condition_38_3 a cco:Condition ;
    cco:hasConditionExpression "for performing their tasks" .

abox:DismissOrPenalizeAction a cco:Action .