@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPRRegulation a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:InformObligation ;
    cco:regulates abox:PersonalDataResource .

abox:InformObligation a cco:Obligation, cco:Norm ;
    cco:hasAction abox:InformAction ;
    cco:hasObject abox:PersonalDataResource ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date .

abox:InformAction a cco:Action .
abox:PersonalDataResource a cco:Resource .