@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation193 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation193 .

abox:Obligation193 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:appliesUnder abox:Condition193 ;
    cco:hasAction abox:RecoverFundingAction ;
    cco:hasObject abox:FundingResource .

abox:Condition193 a cco:Condition ;
    cco:hasConditionExpression "funding is paid for an apprentice who does not subsequently meet the relevant qualifying period" .

abox:RecoverFundingAction a cco:Action .
abox:FundingResource a cco:Resource .