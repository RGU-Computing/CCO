@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation73 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation73 .

abox:Obligation73 a cco:Obligation, cco:Norm ;
    cco:hasAction abox:ConfirmAction ;
    cco:hasObject abox:ApprenticeshipPeriod ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date .

abox:ConfirmAction a cco:Action .
abox:ApprenticeshipPeriod a cco:Resource .