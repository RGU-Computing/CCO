@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation_Clause252 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation_Clause252 .

abox:Obligation_Clause252 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:IncludeContactPoint ;
    cco:hasObject abox:WrittenAgreement, abox:TrainingPlan .

abox:IncludeContactPoint a cco:Action .
abox:WrittenAgreement a cco:Resource .
abox:TrainingPlan a cco:Resource .