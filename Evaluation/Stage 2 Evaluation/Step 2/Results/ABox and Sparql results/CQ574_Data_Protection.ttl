@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Obligation_Article77_2 .

abox:Obligation_Article77_2 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date ;
    cco:appliesToRole abox:SupervisoryAuthorityRole ;
    cco:hasAction abox:InformAction ;
    cco:hasObject abox:ComplaintProgressAndOutcomeInfo .

abox:SupervisoryAuthorityRole a cco:Role .
abox:InformAction a cco:Action .
abox:ComplaintProgressAndOutcomeInfo a cco:Resource .