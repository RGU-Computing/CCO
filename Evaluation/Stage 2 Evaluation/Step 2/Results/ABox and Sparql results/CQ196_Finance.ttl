@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation157 a cco:Regulation ;
    cco:hasValidityStart "2024-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation157 .

abox:Obligation157 a cco:Obligation, cco:Norm ;
    cco:hasAction abox:NotRelySolelyOnQuantitativeModels ;
    cco:hasObject abox:QuantitativeModelsForRiskAssessment .

abox:NotRelySolelyOnQuantitativeModels a cco:Action .
abox:QuantitativeModelsForRiskAssessment a cco:Resource .