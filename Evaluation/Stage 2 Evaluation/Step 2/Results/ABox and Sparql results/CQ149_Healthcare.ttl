@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:StateParty a cco:Organisation, cco:Agent .
abox:ShipDeclarationOfHealth a cco:Resource .
abox:Regulation_Article37 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Permission_Article37_4b ;
    cco:regulates abox:ShipDeclarationOfHealth .
abox:Permission_Article37_4b a cco:Permission, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:appliesToRole abox:StatePartyRole ;
    cco:hasObject abox:ShipDeclarationOfHealth ;
    cco:appliesUnder abox:Condition_ArrivingFromAffectedAreas ;
    cco:appliesUnder abox:Condition_OtherwiseCarryInfection .
abox:Condition_ArrivingFromAffectedAreas a cco:Condition ;
    cco:hasConditionExpression "arriving from affected areas" .
abox:Condition_OtherwiseCarryInfection a cco:Condition ;
    cco:hasConditionExpression "might otherwise carry infection" .
abox:StatePartyRole a cco:Role .
abox:RoleHolding_StateParty a cco:RoleHolding ;
    cco:hasRole abox:StatePartyRole ;
    cco:hasStartTime "2023-01-01"^^xsd:date .
abox:StateParty cco:holdsRole abox:RoleHolding_StateParty .