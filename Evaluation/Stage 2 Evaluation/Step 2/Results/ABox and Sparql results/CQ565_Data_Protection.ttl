@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Obligation70_1_y .

abox:Obligation70_1_y a cco:Obligation, cco:Norm ;
    cco:hasAction abox:MaintainAction ;
    cco:hasObject abox:ElectronicRegister ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date .

abox:MaintainAction a cco:Action .
abox:ElectronicRegister a cco:Resource .