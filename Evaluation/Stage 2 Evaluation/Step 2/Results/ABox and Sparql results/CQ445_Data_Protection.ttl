@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Article49_3_Prohibition .

abox:Article49_3_Prohibition a cco:Prohibition, cco:Norm ;
    cco:appliesToRole abox:PublicAuthorityRole ;
    cco:appliesUnder abox:DerogationCondition ;
    cco:hasValidityStart "2018-05-25"^^xsd:date .

abox:DerogationCondition a cco:Condition ;
    cco:hasConditionExpression "Derogations under Article 49(1)(a), (b), and (c)" .

abox:PublicAuthorityRole a cco:Role .