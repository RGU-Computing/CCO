@prefix cco: <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:EducationRegulation a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:EvidenceObligation ;
    cco:regulates abox:FinancialSystemResource .

abox:EvidenceObligation a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:RetainEvidenceAction ;
    cco:hasObject abox:FinancialSystemResource .

abox:RetainEvidenceAction a cco:Action .

abox:FinancialSystemResource a cco:Resource .