@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Obligation14_3a .

abox:Obligation14_3a a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date ;
    cco:hasAction abox:ProvideInformationAction ;
    cco:appliesToRole abox:ControllerRole ;
    cco:hasObject abox:PersonalDataResource .

abox:ProvideInformationAction a cco:Action .
abox:PersonalDataResource a cco:Resource .
abox:ControllerRole a cco:Role .