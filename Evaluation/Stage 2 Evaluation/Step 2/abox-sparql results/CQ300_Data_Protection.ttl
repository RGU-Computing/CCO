@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Article14_1, abox:Article14_2, abox:Article14_3, abox:Article14_4, abox:Article14_5 .

abox:Article14_1 a cco:Obligation, cco:Norm .
abox:Article14_2 a cco:Obligation, cco:Norm .
abox:Article14_3 a cco:Obligation, cco:Norm .
abox:Article14_4 a cco:Obligation, cco:Norm .
abox:Article14_5 a cco:Exception ;
    cco:modifiesNorm abox:Article14_1, abox:Article14_2, abox:Article14_3, abox:Article14_4 ;
    cco:hasCondition abox:WaiverCondition .

abox:WaiverCondition a cco:Condition ;
    cco:hasConditionExpression "Where the provision of such information proves impossible or would involve a disproportionate effort" .