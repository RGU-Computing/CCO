@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation74 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:PermitApprenticeshipReductionNorm .

abox:PermitApprenticeshipReductionNorm a cco:Permission, cco:Norm ;
    cco:appliesUnder abox:RedundancyCondition74_1 .

abox:RedundancyCondition74_1 a cco:Condition ;
    cco:hasConditionExpression "Is made redundant with more than six, but less than eight months remaining before their final day" .