@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Art28Obligation .

abox:Art28Obligation a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date ;
    cco:hasAction abox:ReturnOrDeleteAction ;
    cco:hasObject abox:PersonalDataResource .

abox:ReturnOrDeleteAction a cco:Action .
abox:PersonalDataResource a cco:Resource .