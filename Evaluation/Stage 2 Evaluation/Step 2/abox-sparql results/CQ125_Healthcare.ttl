@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation_Article31 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Permission_DenyEntry .

abox:Permission_DenyEntry a cco:Permission, cco:Norm ;
    cco:hasAction abox:Action_DenyEntry ;
    cco:appliesUnder abox:Condition_RefusalConsent .

abox:Condition_RefusalConsent a cco:Condition ;
    cco:hasConditionExpression "traveller refuses to consent to a required medical examination" .

abox:Action_DenyEntry a cco:Action .