@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:DataTransferObligation .

abox:DataTransferObligation a cco:Obligation, cco:Norm ;
    cco:appliesToRole abox:RegAuthorityRole .

abox:RegAuthorityRole a cco:RegulatoryAuthorityRole .

abox:RegAuthorityAgent a cco:RegulatoryAuthorityAgent ;
    cco:holdsRole abox:RoleHoldingInstance .

abox:RoleHoldingInstance a cco:RoleHolding ;
    cco:hasRole abox:RegAuthorityRole ;
    cco:hasStartTime "2018-05-25"^^xsd:date .