@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:HealthcareRegulation a cco:Regulation ;
    cco:hasValidityStart "2024-01-01"^^xsd:date ;
    cco:specifiesNorm abox:ConsultationPermission .

abox:ConsultationPermission a cco:Permission, cco:Norm ;
    cco:hasApplicabilityStart "2024-01-01"^^xsd:date ;
    cco:hasAction abox:RequestConsultationAction ;
    cco:appliesUnder abox:ImpactedCondition .

abox:RequestConsultationAction a cco:Action .
abox:ImpactedCondition a cco:Condition ;
    cco:hasConditionExpression "State Party impacted by a health measure" .