@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:CompensationPermission .

abox:CompensationPermission a cco:Permission, cco:Norm ;
    cco:appliesUnder abox:ApportionmentCondition .

abox:ApportionmentCondition a cco:Condition ;
    cco:hasConditionExpression "Where they are joined to the same judicial proceedings, in accordance with Member State law" .