@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation1 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Prohibition1 .

abox:Prohibition1 a cco:Prohibition, cco:Norm ;
    cco:hasAction abox:Action1 ;
    cco:appliesUnder abox:Condition1 .

abox:Action1 a cco:Action .

abox:Condition1 a cco:Condition ;
    cco:hasConditionExpression "Funds must not be used to pay for training for knowledge, skills and behaviours already attained by the apprentice" .