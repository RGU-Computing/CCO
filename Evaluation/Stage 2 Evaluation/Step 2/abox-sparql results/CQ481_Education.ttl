@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation297 a cco:Regulation ;
    cco:hasValidityStart "2024-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Prohibition297 .

abox:Prohibition297 a cco:Prohibition, cco:Norm ;
    cco:hasApplicabilityStart "2024-01-01"^^xsd:date ;
    cco:hasAction abox:MoveBackAction ;
    cco:appliesToRole abox:ApprenticeRole ;
    cco:hasObject abox:StandardResource .

abox:MoveBackAction a cco:Action .
abox:StandardResource a cco:Resource .
abox:ApprenticeRole a cco:Role .