@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation234 a cco:Regulation ;
    cco:hasValidityStart "2024-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Prohibition234 .

abox:Prohibition234 a cco:Prohibition, cco:Norm ;
    cco:hasAction abox:Action234 ;
    cco:appliesToRole abox:ProviderRole .

abox:Action234 a cco:Action .
abox:ProviderRole a cco:Role .