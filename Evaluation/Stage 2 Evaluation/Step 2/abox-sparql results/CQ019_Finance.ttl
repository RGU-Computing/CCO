@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:CapitalRegulation a cco:Regulation ;
    cco:hasValidityStart "2024-01-01"^^xsd:date ;
    cco:specifiesNorm abox:CapitalObligation ;
    cco:regulates abox:CapitalResource .

abox:CapitalObligation a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2024-01-01"^^xsd:date ;
    cco:hasObject abox:CapitalResource .

abox:CapitalResource a cco:Resource .