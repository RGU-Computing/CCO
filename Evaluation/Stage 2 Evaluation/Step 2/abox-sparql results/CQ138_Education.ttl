@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation79 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Prohibition79_2 .

abox:Prohibition79_2 a cco:Prohibition, cco:Norm ;
    cco:hasAction abox:InclusionAction ;
    cco:hasObject abox:StandaloneEnglishMathsQualifications ;
    cco:appliesToRole abox:TrainingRole ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date .

abox:InclusionAction a cco:Action .
abox:StandaloneEnglishMathsQualifications a cco:Resource .
abox:TrainingRole a cco:Role .