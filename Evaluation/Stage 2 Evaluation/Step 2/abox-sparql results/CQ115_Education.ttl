@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation1 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Prohibition1 .

abox:Prohibition1 a cco:Prohibition, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:SigningAction ;
    cco:appliesUnder abox:DualRoleCondition ;
    cco:hasObject abox:ApprenticeshipAgreement .

abox:DualRoleCondition a cco:Condition ;
    cco:hasConditionExpression "Signing as both apprentice and employer" .

abox:SigningAction a cco:Action .

abox:ApprenticeshipAgreement a cco:Resource .