PREFIX cco: <https://www.w3id.org/cco/cco#>
PREFIX abox: <https://www.w3id.org/cco/abox#>

PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?obligation
WHERE {
    abox:Regulation_272 cco:specifiesNorm ?obligation .
    ?obligation a cco:Obligation ;
                cco:hasAction abox:Action_Repay ;
                cco:appliesUnder abox:Condition_ChangeOfCircumstance .
}