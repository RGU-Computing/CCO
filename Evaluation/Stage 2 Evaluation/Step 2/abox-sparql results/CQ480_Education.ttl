@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation296 a cco:Regulation ;
    cco:hasValidityStart "2024-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation296 .

abox:Obligation296 a cco:Obligation, cco:Norm ;
    cco:hasAction abox:EnsureTrainingAction ;
    cco:hasObject abox:TrainingResource ;
    cco:hasApplicabilityStart "2024-01-01"^^xsd:date .

abox:EnsureTrainingAction a cco:Action .
abox:TrainingResource a cco:Resource .