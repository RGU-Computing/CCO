PREFIX cco: <https://www.w3id.org/cco/cco#>
PREFIX abox: <https://www.w3id.org/cco/abox#>

PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?subject ?object
WHERE {
  abox:Obligation_Article38_3 cco:hasAction ?action .
  ?action cco:hasObject abox:HealthPartResource .
  abox:StateParty cco:holdsRole ?roleHolding .
  ?roleHolding cco:hasRole abox:AircraftOperator .
  abox:Obligation_Article38_3 cco:appliesToRole abox:AircraftOperator .
  abox:Obligation_Article38_3 cco:hasAction abox:Action_Inform .
  abox:Action_Inform cco:hasSubject ?subject .
  abox:Action_Inform cco:hasObject ?object .
}