@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:BreachNotificationObligation .

abox:BreachNotificationObligation a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date ;
    cco:appliesUnder abox:BreachOccurredCondition ;
    cco:hasAction abox:NotifyBreachAction .

abox:BreachOccurredCondition a cco:Condition ;
    cco:hasConditionExpression "notification of a personal data breach cannot be made within 72 hours" .

abox:NotifyBreachAction a cco:Action .