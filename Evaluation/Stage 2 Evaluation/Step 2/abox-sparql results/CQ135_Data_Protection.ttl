@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:BreachCommunicationObligation .

abox:BreachCommunicationObligation a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date ;
    cco:hasAction abox:CommunicateBreach ;
    cco:appliesToRole abox:ControllerRole ;
    cco:hasObject abox:PersonalDataBreach ;
    cco:appliesUnder abox:HighRiskCondition .

abox:CommunicateBreach a cco:Action .
abox:ControllerRole a cco:Role .
abox:PersonalDataBreach a cco:Resource .
abox:HighRiskCondition a cco:Condition ;
    cco:hasConditionExpression "breach likely to result in high risk to rights and freedoms" .