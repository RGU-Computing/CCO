@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation163 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation163 .

abox:Obligation163 a cco:Obligation, cco:Norm ;
    cco:hasAction abox:EstablishAction ;
    cco:hasObject abox:NPAPolicy ;
    cco:appliesToRole abox:InstitutionRole .

abox:EstablishAction a cco:Action .
abox:NPAPolicy a cco:Resource .
abox:InstitutionRole a cco:Role .