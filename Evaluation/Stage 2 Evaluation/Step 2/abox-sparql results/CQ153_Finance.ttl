@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Reg129 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation129 .

abox:Obligation129 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:DocumentAction ;
    cco:hasObject abox:LoanDataResource .

abox:DocumentAction a cco:Action .
abox:LoanDataResource a cco:Resource .