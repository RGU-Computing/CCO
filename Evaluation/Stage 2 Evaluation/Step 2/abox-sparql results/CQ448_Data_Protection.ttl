@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:TransferPermission .

abox:TransferPermission a cco:Permission, cco:Norm ;
    cco:appliesUnder abox:CompellingInterestCondition ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date .

abox:CompellingInterestCondition a cco:Condition ;
    cco:hasConditionExpression "the transfer is not repetitive, concerns only a limited number of data subjects, is necessary for the purposes of compelling legitimate interests pursued by the controller" .