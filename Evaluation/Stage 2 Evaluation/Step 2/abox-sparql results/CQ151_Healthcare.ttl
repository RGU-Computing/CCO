@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation_1 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation_1 .

abox:Obligation_1 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:appliesToRole abox:PilotRole ;
    cco:hasAction abox:CompleteAndDeliverAction ;
    cco:hasObject abox:HealthPartResource .

abox:PilotRole a cco:Role .
abox:CompleteAndDeliverAction a cco:Action .
abox:HealthPartResource a cco:Resource .