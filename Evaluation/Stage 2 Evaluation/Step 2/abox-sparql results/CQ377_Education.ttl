@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:OfstedRegulation a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation241_5 .

abox:Obligation241_5 a cco:Obligation, cco:Norm ;
    cco:hasAction abox:ProvideEvidenceAction ;
    cco:appliesToRole abox:SubcontractorRole .

abox:ProvideEvidenceAction a cco:Action .
abox:SubcontractorRole a cco:Role .