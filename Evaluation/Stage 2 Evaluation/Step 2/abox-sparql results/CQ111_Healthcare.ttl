@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:HealthcareRegulation a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:CessationNorm .

abox:CessationNorm a cco:Norm, cco:Obligation ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:appliesUnder abox:CessationCondition .

abox:CessationCondition a cco:Condition ;
    cco:hasConditionExpression "the measures have been effectively carried out" .