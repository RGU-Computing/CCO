@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation_235 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation_235 .

abox:Obligation_235 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:appliesToRole abox:ProviderRole ;
    cco:hasAction abox:EnsureComplianceAction ;
    cco:hasObject abox:ProcurementResource .

abox:ProviderRole a cco:Role .
abox:EnsureComplianceAction a cco:Action .
abox:ProcurementResource a cco:Resource .