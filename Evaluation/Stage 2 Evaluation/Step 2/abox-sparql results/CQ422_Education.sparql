PREFIX cco: <https://www.w3id.org/cco/cco#>
PREFIX abox: <https://www.w3id.org/cco/abox#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?startDate WHERE {
    abox:ExemptionObligation cco:hasApplicabilityStart ?startDate .
    abox:ExemptionObligation cco:appliesUnder abox:NeededCondition .
    abox:NeededCondition cco:hasConditionExpression "Where needed" .
}