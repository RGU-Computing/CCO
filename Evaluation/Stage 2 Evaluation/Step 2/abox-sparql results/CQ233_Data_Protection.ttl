@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR_Article89_1 a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:GDPR_Article89_1_Permission .

abox:GDPR_Article89_1_Permission a cco:Permission, cco:Norm ;
    cco:appliesUnder abox:NonIdentifiableCondition .

abox:NonIdentifiableCondition a cco:Condition ;
    cco:hasConditionExpression "the controller has assessed the feasibility to fulfil those purposes by processing data which do not permit or no longer permit the identification of data subjects" .