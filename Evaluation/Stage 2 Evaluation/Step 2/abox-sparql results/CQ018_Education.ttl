@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation1 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Prohibition1 .

abox:Prohibition1 a cco:Prohibition, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:Action1 ;
    cco:hasObject abox:Resource1 ;
    cco:appliesUnder abox:Condition1 ;
    cco:hasException abox:Exception1 .

abox:Action1 a cco:Action .
abox:Resource1 a cco:Resource .
abox:Condition1 a cco:Condition ;
    cco:hasConditionExpression "fund an apprentice working under IR35"^^xsd:string .

abox:Exception1 a cco:Exception ;
    cco:modifiesNorm abox:Prohibition1 ;
    cco:hasCondition abox:Condition2 .

abox:Condition2 a cco:Condition ;
    cco:hasConditionExpression "meet alternative arrangements"^^xsd:string .