PREFIX cco: <https://www.w3id.org/cco/cco#>
PREFIX abox: <https://www.w3id.org/cco/abox#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?action
WHERE {
  ?permission a cco:Permission .
  ?permission cco:hasAction ?action .
  ?permission cco:appliesUnder ?condition .
  ?condition cco:hasConditionExpression "strictly necessary and proportionate for network and information security" .
}