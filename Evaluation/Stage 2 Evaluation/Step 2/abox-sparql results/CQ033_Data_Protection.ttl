@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPRRegulation a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Article4Norm .

abox:Article4Norm a cco:Permission, cco:Norm ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date ;
    cco:appliesToRole abox:PublicAuthorityRole ;
    cco:hasObject abox:PersonalDataResource .

abox:PersonalDataResource a cco:Resource .

abox:PublicAuthorityRole a cco:Role .