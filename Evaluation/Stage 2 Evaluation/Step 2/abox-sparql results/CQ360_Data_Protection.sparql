PREFIX cco: <https://www.w3id.org/cco/cco#>
PREFIX abox: <https://www.w3id.org/cco/abox#>

PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?obligation
WHERE {
  abox:Article29Prohibition cco:appliesToRole abox:ProcessorRole ;
                           cco:appliesUnder abox:AccessCondition ;
                           cco:hasAction abox:ProcessDataAction ;
                           cco:hasObject abox:PersonalDataResource .
  abox:AccessCondition cco:hasConditionExpression "has access to personal data" .
  abox:Article29Prohibition a cco:Norm .
  BIND(abox:Article29Prohibition AS ?obligation)
}