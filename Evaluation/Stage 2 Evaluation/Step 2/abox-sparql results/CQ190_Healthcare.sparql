PREFIX cco: <https://www.w3id.org/cco/cco#>
PREFIX abox: <https://www.w3id.org/cco/abox#>

PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?support
WHERE {
  abox:Obligation1 cco:hasAction ?action .
  abox:Obligation1 cco:hasObject ?resource .
  abox:Obligation1 cco:appliesUnder ?condition .
  ?condition cco:hasConditionExpression "upon request"^^xsd:string .
  BIND(CONCAT(STR(?action), " ", STR(?resource)) AS ?support)
}