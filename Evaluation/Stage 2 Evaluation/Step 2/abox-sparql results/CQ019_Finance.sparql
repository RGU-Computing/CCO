PREFIX cco: <https://www.w3id.org/cco/cco#>
PREFIX abox: <https://www.w3id.org/cco/abox#>

PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?resource
WHERE {
    abox:CapitalObligation cco:hasObject ?resource .
    abox:CapitalObligation a cco:Obligation .
    abox:CapitalRegulation cco:specifiesNorm abox:CapitalObligation .
    abox:CapitalRegulation cco:regulates ?resource .
    abox:CapitalResource a cco:Resource .
    FILTER (?resource = abox:CapitalResource)
}