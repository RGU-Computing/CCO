@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation1 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation1 .

abox:Obligation1 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:appliesToRole abox:ManagementRole ;
    cco:hasAction abox:DisclosureOversightAction ;
    cco:hasObject abox:DisclosureResource ;
    cco:appliesUnder abox:Condition1 .

abox:ManagementRole a cco:Role .

abox:DisclosureOversightAction a cco:Action .

abox:DisclosureResource a cco:Resource .

abox:Condition1 a cco:Condition ;
    cco:hasConditionExpression "oversight of disclosure and communications with external stakeholders and competent authorities"^^xsd:string .