@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:HealthcareRegulation a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:MonitoringObligation ;
    cco:regulates abox:Baggage, abox:Cargo, abox:Conveyances .

abox:MonitoringObligation a cco:Obligation, cco:Norm ;
    cco:hasAction abox:MonitorAction ;
    cco:appliesToRole abox:CompetentAuthorityRole ;
    cco:hasObject abox:Baggage, abox:Cargo, abox:Conveyances .

abox:Baggage a cco:Resource .
abox:Cargo a cco:Resource .
abox:Conveyances a cco:Resource .
abox:MonitorAction a cco:Action .
abox:CompetentAuthorityRole a cco:Role .