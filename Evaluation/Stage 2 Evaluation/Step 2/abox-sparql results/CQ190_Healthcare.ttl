@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation1 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation1 .

abox:Obligation1 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:Action1 ;
    cco:appliesUnder abox:Condition1 ;
    cco:hasObject abox:Resource1 .

abox:Action1 a cco:Action .
abox:Condition1 a cco:Condition ;
    cco:hasConditionExpression "upon request"^^xsd:string .
abox:Resource1 a cco:Resource .