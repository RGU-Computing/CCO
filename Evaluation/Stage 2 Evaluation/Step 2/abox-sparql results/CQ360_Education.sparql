PREFIX cco: <https://www.w3id.org/cco/cco#>
PREFIX abox: <https://www.w3id.org/cco/abox#>
SELECT ?obligation WHERE {
  ?obligation a cco:Obligation ;
              cco:appliesToRole abox:ProviderRole ;
              cco:hasAction abox:EnsureAction ;
              cco:hasObject abox:ApprenticeshipStandards .
}