@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation279_1 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation279_1 .

abox:Obligation279_1 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:FundRemainingCostsAction ;
    cco:appliesUnder abox:ApprenticeRedundancyCondition .

abox:FundRemainingCostsAction a cco:Action .

abox:ApprenticeRedundancyCondition a cco:Condition ;
    cco:hasConditionExpression "apprentice is made redundant after completing at least 75% of their practical period" .