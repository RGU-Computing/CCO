@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation94 a cco:Regulation ;
    cco:hasValidityStart "2024-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation94 .

abox:Obligation94 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2024-01-01"^^xsd:date ;
    cco:hasAction abox:Action94 ;
    cco:appliesToRole abox:Role94 .

abox:Action94 a cco:Action .
abox:Role94 a cco:Role .