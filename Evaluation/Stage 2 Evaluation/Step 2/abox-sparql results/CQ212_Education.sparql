PREFIX cco: <https://www.w3id.org/cco/cco#>
PREFIX abox: <https://www.w3id.org/cco/abox#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?validityStartDate WHERE {
  ?regulation a cco:Regulation ;
              cco:hasValidityStart ?validityStartDate ;
              cco:specifiesNorm abox:Obligation99 .
}