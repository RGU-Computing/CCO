@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation1 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Permission1 .

abox:Permission1 a cco:Permission, cco:Norm ;
    cco:appliesToRole abox:Role1 ;
    cco:hasObject abox:Resource1 .

abox:Role1 a cco:Role .

abox:Resource1 a cco:Resource .