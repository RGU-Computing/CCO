@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:IHR2005 a cco:Regulation ;
    cco:hasValidityStart "2005-01-01"^^xsd:date ;
    cco:specifiesNorm abox:EstablishCommitteeObligation .

abox:EstablishCommitteeObligation a cco:Obligation, cco:Norm ;
    cco:hasAction abox:EstablishAction .

abox:EstablishAction a cco:Action .