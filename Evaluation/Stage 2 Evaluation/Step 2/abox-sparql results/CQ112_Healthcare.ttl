@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation_Article28.1 a cco:Regulation ;
    cco:hasValidityStart "2024-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation_Article28.1 .

abox:Obligation_Article28.1 a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2024-01-01"^^xsd:date ;
    cco:hasAction abox:Action_ProceedToNearestSuitableEntry ;
    cco:appliesUnder abox:Condition_NotEquippedForHealthMeasures ;
    cco:hasObject abox:Resource_ShipOrAircraftArrivingAtEntry .

abox:Condition_NotEquippedForHealthMeasures a cco:Condition ;
    cco:hasConditionExpression "not equipped for health measures"^^xsd:string .

abox:Action_ProceedToNearestSuitableEntry a cco:Action .

abox:Resource_ShipOrAircraftArrivingAtEntry a cco:Resource .