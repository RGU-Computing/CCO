@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:EducationRegulation a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:ExemptionObligation .

abox:ExemptionObligation a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:hasAction abox:ApplyAction ;
    cco:appliesUnder abox:NeededCondition ;
    cco:hasException abox:ThresholdException .

abox:NeededCondition a cco:Condition ;
    cco:hasConditionExpression "Where needed" .

abox:ThresholdException a cco:Exception ;
    cco:modifiesNorm abox:ExemptionObligation ;
    cco:hasCondition abox:NeededCondition .

abox:ApplyAction a cco:Action .