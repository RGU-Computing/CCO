@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPR a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:Art57_1k_Obligation .

abox:Art57_1k_Obligation a cco:Obligation, cco:Norm ;
    cco:hasAction abox:EstablishMaintainListAction ;
    cco:hasApplicabilityStart "2018-05-25"^^xsd:date .

abox:EstablishMaintainListAction a cco:Action .