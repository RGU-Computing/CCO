@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation103 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:PermitSubcontracting .

abox:PermitSubcontracting a cco:Permission, cco:Norm ;
    cco:hasAction abox:BuyInDelivery ;
    cco:hasObject abox:ApprenticeshipTrainingResource .

abox:BuyInDelivery a cco:Action .
abox:ApprenticeshipTrainingResource a cco:Resource .