@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation140_1 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation55Hours .

abox:Obligation55Hours a cco:Obligation, cco:Norm ;
    cco:hasException abox:ExceptionReduction .

abox:ExceptionReduction a cco:Exception ;
    cco:modifiesNorm abox:Obligation55Hours ;
    cco:hasCondition abox:ConditionPriorKnowledge .

abox:ConditionPriorKnowledge a cco:Condition ;
    cco:hasConditionExpression "due to prior knowledge the learner requires less than 55 guided learning hours" .