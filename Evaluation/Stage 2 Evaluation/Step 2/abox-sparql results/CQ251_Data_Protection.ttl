@prefix cco:  <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:GDPRRegulation a cco:Regulation ;
    cco:hasValidityStart "2018-05-25"^^xsd:date ;
    cco:specifiesNorm abox:GDPR_Article5_1a_Obligation .

abox:GDPR_Article5_1a_Obligation a cco:Obligation, cco:Norm ;
    cco:hasAction abox:LawfulFairTransparentProcessingAction .

abox:LawfulFairTransparentProcessingAction a cco:Action .