@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix abox: <https://www.w3id.org/cco/abox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:Regulation_Clause48 a cco:Regulation ;
    cco:hasValidityStart "2023-01-01"^^xsd:date ;
    cco:specifiesNorm abox:Obligation_Assessment .

abox:Obligation_Assessment a cco:Obligation, cco:Norm ;
    cco:hasApplicabilityStart "2023-01-01"^^xsd:date ;
    cco:appliesToRole abox:ProviderRole ;
    cco:hasAction abox:AssessmentAction ;
    cco:hasObject abox:ApprenticeResource ;
    cco:appliesUnder abox:FundedCondition .

abox:ProviderRole a cco:Role .
abox:AssessmentAction a cco:Action .
abox:ApprenticeResource a cco:Resource .
abox:FundedCondition a cco:Condition ;
    cco:hasConditionExpression "English and/or maths is being funded" .