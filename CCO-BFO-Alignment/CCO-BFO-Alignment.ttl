@prefix : <http://www.example.org/cco#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix cco: <http://www.example.org/cco#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://www.example.org/cco-bfo-alignment#> .

<http://www.example.org/cco-bgo-alignment> rdf:type owl:Ontology ;
								owl:imports <http://www.example.org/cco> ;
                              dc:creator "Umair Arshad" ;
                              dc:date "2026" ;
                              dc:description "Alignments between the Core Compliance Ontology and relevant concepts in the BFO Core and BFO Role ontologies, and the Normative Requirements Vocabulary."@en ;
                              <http://purl.org/dc/terms/contributor> "David Corsar" ,
                                                                     "Ikechukwu Nkisi-Orji" ;
                              <http://purl.org/dc/terms/rights> "This ontology is licensed under the Creative Commons Attribution 4.0 International License (CC-BY 4.0). You are free to share and adapt this ontology, provided that you give appropriate credit. More details: https://creativecommons.org/licenses/by/4.0/" ;
                              rdfs:label "Core Compliance Ontology (CCO)"@en ;
                              owl:versionInfo "1.0" .



###  http://www.example.org/cco#Norm
cco:Norm rdf:type owl:Class ;
         rdfs:subClassOf <http://ns.inria.fr/nrv#NormativeRequirement> .


###  http://www.example.org/cco#Organisation
cco:Organisation rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> .


###  http://www.example.org/cco#Person
cco:Person rdf:type owl:Class ;
           rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000030> .


###  http://www.example.org/cco#Role
cco:Role rdf:type owl:Class ;
         rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .


###  http://www.example.org/cco#RoleHolding
cco:RoleHolding rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .


###  http://www.example.org/cco#Action
cco:Action skos:closeMatch "http://www.w3.org/ns/odrl/2/Action" .

cco:Obligation  skos:closeMatch "http://docs.oasis-open.org/legalruleml/ns/v1.0/metamodel#Obligation" .


cco:Permission skos:closeMatch "http://docs.oasis-open.org/legalruleml/ns/v1.0/metamodel#Permission" .

cco:Prohibition  skos:closeMatch "http://docs.oasis-open.org/legalruleml/ns/v1.0/metamodel#Prohibition" .

cco:Regulation skos:exactMatch "https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Regulation" .
cco:RegulatoryAuthorityRole skos:closeMatch "http://www.estrellaproject.org/lkif-core/legal-role.owl#Legal_Role" .


