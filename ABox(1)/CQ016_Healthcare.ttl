@prefix cco:  <http://www.example.org/cco#> .
@prefix abox: <http://www.example.org/abox#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

abox:IHRRegulation a cco:Regulation ;
    cco:hasValidityStart "2005-05-23"^^xsd:date ;
    cco:specifiesNorm abox:DesignateObligation .

abox:DesignateObligation a cco:Obligation, cco:Norm ;
    cco:hasAction abox:DesignateAction ;
    cco:appliesToRole abox:StatePartyRole .

abox:DesignateAction a cco:Action .
abox:StatePartyRole a cco:Role .